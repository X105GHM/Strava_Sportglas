CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_BT_ENABLED=n
CONFIG_SPIRAM=n
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# Altium-Platine vom 09.10.2026: PICO-MINI-02, AHCT-Buffer, schaltbare 5 V.
CONFIG_DISPLAY_DATA_GPIO=21
CONFIG_DISPLAY_POWER_GPIO=19
CONFIG_DISPLAY_OE_GPIO=-1
CONFIG_DISPLAY_TOUCH_GPIO=4
CONFIG_DISPLAY_PERSIST_TOUCH_CALIBRATION=n
# Pinbelegung mit Schaltplan und PCB abgeglichen.
CONFIG_DISPLAY_BOARD_VERIFIED=y
# Sportauswahl: n = Triathlon, y = nur Radfahren.
CONFIG_DISPLAY_CYCLING_ONLY=y
# Farbskala: 0 % Rot, 50 % Gelb, 100 % Grün.
# CONFIG_DISPLAY_SPORT_STYLE_FIXED_BRIGHTNESS is not set
CONFIG_DISPLAY_SPORT_STYLE_RED_GREEN_SCALE=y

CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
# CONFIG_BOOTLOADER_LOG_LEVEL_INFO is not set
# CONFIG_LOG_DEFAULT_LEVEL_INFO is not set
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
# CONFIG_LOG_TAG_LEVEL_IMPL_CACHE_AND_LINKED_LIST is not set
# CONFIG_LOG_TAG_LEVEL_IMPL_LINKED_LIST is not set
CONFIG_LOG_TAG_LEVEL_IMPL_NONE=y
CONFIG_LOG_DYNAMIC_LEVEL_CONTROL=n
# Produktionsbetrieb: Light Sleep aktiv, reguläre Logs und serielle Befehle aus.
CONFIG_DISPLAY_SERIAL_DEBUG=n
