# Project-owned display/log settings have one source of truth, even with an
# existing ESP-IDF sdkconfig. Leave all other SDK settings untouched.
function(strava_sync_display_config defaults)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${defaults}")
    if(DEFINED SDKCONFIG)
        set(target "${SDKCONFIG}")
    else()
        set(target "${CMAKE_SOURCE_DIR}/sdkconfig")
    endif()
    if(NOT EXISTS "${target}")
        return() # ESP-IDF will create it from the defaults.
    endif()
    file(READ "${target}" original)
    string(REPLACE "\r\n" "\n" updated "${original}")
    set(owned "CONFIG_(DISPLAY_[A-Z0-9_]+|LOG_DEFAULT_LEVEL_[A-Z]+|LOG_TAG_LEVEL_IMPL_[A-Z_]+|LOG_MAXIMUM_EQUALS_DEFAULT|LOG_DYNAMIC_LEVEL_CONTROL|BOOTLOADER_LOG_LEVEL_[A-Z]+)")
    file(STRINGS "${defaults}" settings REGEX "^(${owned}=|# ${owned} is not set)")
    foreach(setting IN LISTS settings)
        string(REGEX MATCH "${owned}" key "${setting}")
        set(pattern "(^|\n)(# )?${key}(=[^\n]*| is not set)(\n|$)")
        if(updated MATCHES "${pattern}")
            string(REGEX REPLACE "${pattern}" "\\1${setting}\\4" updated "${updated}")
        else()
            string(APPEND updated "\n${setting}\n")
        endif()
    endforeach()
    if(NOT updated STREQUAL original)
        file(WRITE "${target}" "${updated}")
    endif()
endfunction()
